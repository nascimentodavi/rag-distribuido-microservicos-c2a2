# ---- LLM ----------------------------------------------------------------
# Deixe LLM_API_KEY vazia para usar o MODO SIMULADO (offline).
# NUNCA coloque a chave no codigo: apenas aqui, no .env (ignorado pelo git).
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODELO=gpt-4o-mini
LLM_TIMEOUT=8
LLM_TENTATIVAS=3

# ---- Resiliencia ---------------------------------------------------------
DISJUNTOR_LIMITE_FALHAS=3
DISJUNTOR_ESPERA_SEGUNDOS=20
# normal | erro | lentidao | intermitente (tambem alteravel via POST /admin/falhas)
LLM_SIMULAR_FALHA=normal

# ---- Execucao local sem Docker (os nomes abaixo valem so fora do compose) ----
URL_INGESTAO=http://localhost:8001
URL_RECUPERACAO=http://localhost:8002
REDIS_URL=redis://localhost:6379/0
CAMINHO_INDICE=dados/indice.joblib
